// First, lets define init.rc scripts...
// These scripts are usually located at vendor/etc/init in your OTA dump...

prebuilt_etc {
    name: "init.at.qcom.rc",
    src: "init.at.qcom.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.at.target.rc",
    src: "init.at.target.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.qcom.rc",
    src: "init.qcom.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.qti.kernel.rc",
    src: "init.qti.kernel.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.recovery.qcom.rc",
    src: "init.recovery.qcom.rc",
    sub_dir: "init",
    vendor: true,
}

prebuilt_etc {
    name: "init.recovery.usb.rc",
    src: "init.recovery.usb.rc",
    sub_dir: "init",
    vendor: true,
}

prebuilt_etc {
    name: "init.target.rc",
    src: "init.target.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.thermal-engine-v2.rc",
    src: "init_thermal-engine-v2.rc",
    sub_dir: "init",
    vendor: true,
}

prebuilt_etc {
    name: "ueventd.qcom.rc",
    src: "ueventd.qcom.rc",
    sub_dir: "init/hw",
    vendor: true,
}

// Then come regular vendor/bin/sh scripts
// These scripts are usually located at vendor/bin in your OTA dump...

sh_binary {
    name: "init.at.class_main.sh",
    src: "init.at.class_main.sh",
    sub_dir: "bin",
    vendor: true,
}

sh_binary {
    name: "init.at.post_boot.sh",
    src: "init.at.post_boot.sh",
    sub_dir: "bin",
    vendor: true,
}

sh_binary {
    name: "init.class_main.sh",
    src: "init.class_main.sh",
    sub_dir: "bin",
    vendor: true,
}

sh_binary {
    name: "init.kernel.post_boot-blair.sh",
    src: "init.kernel.post_boot-blair.sh",
    sub_dir: "bin",
    vendor: true,
}

sh_binary {
    name: "init.kernel.post_boot-holi.sh",
    src: "init.kernel.post_boot-holi.sh",
    sub_dir: "bin",
    vendor: true,
}

sh_binary {
    name: "init.kernel.post_boot.sh",
    src: "init.kernel.post_boot.sh",
    sub_dir: "bin",
    vendor: true,
}

sh_binary {
    name: "init.qcom.early_boot.sh",
    src: "init.qcom.early_boot.sh",
    sub_dir: "bin",
    vendor: true,
}

sh_binary {
    name: "init.qcom.post_boot.sh",
    src: "init.qcom.post_boot.sh",
    sub_dir: "bin",
    vendor: true,
}

sh_binary {
    name: "init.qcom.sh",
    src: "init.qcom.sh",
    sub_dir: "bin",
    vendor: true,
}

sh_binary {
    name: "init.qti.kernel.sh",
    src: "init.qti.kernel.sh",
    sub_dir: "bin",
    vendor: true,
}

// Also, lets define fstab.
// It usually locates at vendor/etc and mounts partitions at boot.
// Needed in every case!
// P.S. For custom ROM with OPPO devices you will need to deprecate my_* partitions from fstab. Do it carefully, a missed flag can cause problems with partitions mounting.

prebuilt_etc {
    name: "fstab.qcom",
    src: "fstab.qcom",
    vendor: true,
    vendor_ramdisk_available: true, // Thus we define that recovery or vendor_boot can access it.
}
