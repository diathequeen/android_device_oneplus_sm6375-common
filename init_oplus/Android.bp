// First, lets define init.rc scripts...
// These scripts are usually located at vendor/etc/init in your OTA dump...

prebuilt_etc {
    name: "init.oplus.bsp_debug.rc",
    src: "init.oplus.bsp_debug.rc",
    sub_dir: "init/hw",
    device_specific: true,
}

prebuilt_etc {
    name: "init.oplus.bt.rc",
    src: "init.oplus.bt.rc",
    sub_dir: "init",
    device_specific: true,
}

prebuilt_etc {
    name: "init.oplus.display.rc",
    src: "init.oplus.display.rc",
    sub_dir: "init/hw",
    device_specific: true,
}

prebuilt_etc {
    name: "init.oplus.face.rc",
    src: "init.oplus.face.rc",
    device_specific: true,
}

prebuilt_etc {
    name: "init.oplus.fingerprints.rc",
    src: "init.oplus.fingerprints.rc",
    device_specific: true,
}

prebuilt_etc {
    name: "init.oplus.seccommon.rc",
    src: "init.oplus.seccommon.rc",
    device_specific: true,
}

prebuilt_etc {
    name: "init.oplus.sensor.rc",
    src: "init.oplus.sensor.rc",
    sub_dir: "init",
    device_specific: true,
}

prebuilt_etc {
    name: "init.oplus.wifi.rc",
    src: "init.oplus.wifi.rc",
    sub_dir: "init/hw",
    device_specific: true,
}

prebuilt_etc {
    name: "init.oppo.reserve.rc",
    src: "init.oppo.reserve.rc",
    sub_dir: "init",
    device_specific: true,
}

// Then come regular vendor/bin/sh scripts
// These scripts, however, are usually located at vendor/bin in your OTA dump...

sh_binary {
    name: "init.oplus.bsp_debug.sh",
    src: "init.oplus.bsp_debug.sh",
    sub_dir: "bin",
    device_specific: true,
}

sh_binary {
    name: "init.oplus.bsp_us_dump.sh",
    src: "init.oplus.bsp_us_dump.sh",
    sub_dir: "bin",
    device_specific: true,
}

sh_binary {
    name: "init.oplus.btChangePermission.sh",
    src: "init.oplus.btChangePermission.sh",
    sub_dir: "bin",
    device_specific: true,
}

sh_binary {
    name: "init.oplus.fingerprints.sh",
    src: "init.oplus.fingerprints.sh",
    sub_dir: "bin",
    device_specific: true,
}

sh_binary {
    name: "init.oplus.wifi.sh",
    src: "init.oplus.wifi.sh",
    sub_dir: "bin",
    device_specific: true,
}
